/* ── Life journey (orb walks the grid) ─────────────────────── */

.pl3-journey {
  position: relative;
  z-index: 5;
}

.pl3-journey__stage {
  position: sticky;
  top: 0;
  display: flex;
  height: 100svh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 5rem 1.25rem 3rem;
}

.pl3-journey__eyebrow {
  position: absolute;
  top: clamp(4.5rem, 10vh, 6.5rem);
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--ash-dim);
}

.pl3-journey__rail {
  position: absolute;
  bottom: 1.75rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 0.45rem;
}

.pl3-journey__tick {
  width: 0.35rem;
  height: 0.35rem;
  border-radius: 999px;
  background: rgba(200, 192, 180, 0.22);
  transition:
    width 0.4s ease,
    background 0.4s ease,
    box-shadow 0.4s ease;
}

.pl3-journey__tick[data-on] {
  background: rgba(255, 163, 43, 0.45);
}

.pl3-journey__tick[data-now] {
  width: 1.25rem;
  background: var(--ember);
  box-shadow: 0 0 12px rgba(255, 163, 43, 0.45);
}

.pl3-journey__cards {
  position: relative;
  width: min(1100px, 100%);
  height: min(62vh, 420px);
}

.pl3-jcard {
  position: absolute;
  top: 50%;
  width: min(42%, 320px);
  transform: translateY(-50%);
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.16, 0.8, 0.24, 1),
    filter 0.55s ease;
  filter: blur(6px);
}

.pl3-jcard[data-side="left"] {
  left: 0;
  transform: translate(-12%, -50%);
}

.pl3-jcard[data-side="right"] {
  right: 0;
  transform: translate(12%, -50%);
}

.pl3-jcard[data-lit] {
  opacity: 1;
  filter: blur(0);
  pointer-events: auto;
}

.pl3-jcard[data-side="left"][data-lit] {
  transform: translate(0, -50%);
}

.pl3-jcard[data-side="right"][data-lit] {
  transform: translate(0, -50%);
}

.pl3-jcard[data-passed] {
  opacity: 0.12;
  filter: blur(2px);
}

.pl3-jcard[data-side="left"][data-passed] {
  transform: translate(-6%, -50%) scale(0.96);
}

.pl3-jcard[data-side="right"][data-passed] {
  transform: translate(6%, -50%) scale(0.96);
}

.pl3-jcard__panel {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  padding: 1.15rem 1.2rem 1.25rem;
  border: 1px solid rgba(222, 176, 112, 0.28);
  border-radius: 14px;
  background: linear-gradient(
    155deg,
    rgba(255, 240, 214, 0.07),
    rgba(255, 240, 214, 0.015)
  );
  box-shadow:
    0 0 48px rgba(255, 174, 71, 0.08),
    inset 0 1px 0 rgba(255, 244, 226, 0.06);
  color: var(--filament);
  backdrop-filter: blur(10px);
}

.pl3-jcard[data-lit] .pl3-jcard__panel {
  border-color: rgba(255, 163, 43, 0.45);
  box-shadow:
    0 0 56px rgba(255, 174, 71, 0.16),
    inset 0 1px 0 rgba(255, 244, 226, 0.08);
}

.pl3-jcard__tag {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ember);
}

.pl3-jcard__line {
  font-size: 0.92rem;
  line-height: 1.5;
  color: var(--ash);
}

.pl3-scene {
  color: rgba(255, 174, 71, 0.55);
  height: 5.5rem;
}

.pl3-jcard[data-lit] .pl3-scene {
  color: var(--ember);
}

.pl3-scene__svg {
  width: 100%;
  height: 100%;
}

/* Wealth — bars rise, trend draws */
.pl3-scene__bar {
  fill: currentColor;
  opacity: 0.35;
  transform-box: fill-box;
  transform-origin: bottom center;
  transform: scaleY(0.12);
}

.pl3-scene[data-active] .pl3-scene__bar {
  animation: pl3-bar-rise 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
  animation-delay: calc(var(--bar-i, 0) * 80ms);
}

.pl3-scene[data-active] .pl3-scene__bar--peak {
  animation:
    pl3-bar-rise 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards,
    pl3-bar-glow 2.2s 1.1s ease-in-out infinite;
  animation-delay: calc(var(--bar-i, 0) * 80ms), 1.1s;
}

.pl3-scene__wealth-area {
  opacity: 0;
  pointer-events: none;
}

.pl3-scene[data-active] .pl3-scene__wealth-area {
  animation: pl3-fade 0.8s 0.55s ease forwards;
}

.pl3-scene__trend {
  stroke-dasharray: 180;
  stroke-dashoffset: 180;
  opacity: 0.85;
}

.pl3-scene[data-active] .pl3-scene__trend {
  animation: pl3-draw 1.2s 0.35s ease forwards;
}

.pl3-scene__caption {
  fill: currentColor;
  font-size: 10px;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__caption {
  animation: pl3-dot-in 0.35s 1.05s ease forwards;
}

.pl3-scene__axis {
  opacity: 0.25;
}

.pl3-scene__dot {
  fill: currentColor;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__dot {
  animation: pl3-dot-in 0.4s 1s ease forwards;
}

/* Health — pulse travels */
.pl3-scene__pulse {
  stroke-dasharray: 220;
  stroke-dashoffset: 220;
}

.pl3-scene[data-active] .pl3-scene__pulse {
  animation: pl3-draw 1.1s ease forwards, pl3-pulse-glow 2.4s 1s ease-in-out infinite;
}

.pl3-scene[data-active] .pl3-scene__dot--pulse {
  animation: pl3-dot-in 0.35s 0.7s ease forwards, pl3-beat 1.2s 1s ease-in-out infinite;
}

/* Work — blocks slide in */
.pl3-scene__block {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.2;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__block--a {
  animation: pl3-slide-a 0.7s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__block--b {
  animation: pl3-slide-b 0.7s 0.15s ease forwards;
}

.pl3-scene__link {
  opacity: 0;
}
.pl3-scene[data-active] .pl3-scene__link {
  animation: pl3-fade 0.4s 0.5s ease forwards;
}

/* People — nodes bloom */
.pl3-scene__node {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.2;
  opacity: 0;
  transform-origin: center;
}
.pl3-scene[data-active] .pl3-scene__node {
  animation: pl3-node-in 0.5s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__node--b {
  animation-delay: 0.1s;
}
.pl3-scene[data-active] .pl3-scene__node--c {
  animation-delay: 0.18s;
}
.pl3-scene[data-active] .pl3-scene__node--d {
  animation-delay: 0.26s;
}

/* Habits — ring fills */
.pl3-scene__ring {
  stroke-dashoffset: 176;
}
.pl3-scene[data-active] .pl3-scene__ring {
  animation: pl3-ring 1.4s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
}

/* Mind — arcs draw */
.pl3-scene__arc {
  stroke-dasharray: 80;
  stroke-dashoffset: 80;
}
.pl3-scene[data-active] .pl3-scene__arc--a {
  animation: pl3-draw 0.8s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__arc--b {
  animation: pl3-draw 0.9s 0.12s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__arc--c {
  animation: pl3-draw 1s 0.22s ease forwards;
}

/* Time — wedge grows */
.pl3-scene__wedge {
  opacity: 0.55;
  transform-origin: 80px 44px;
  transform: scale(0.2);
}
.pl3-scene[data-active] .pl3-scene__wedge {
  animation: pl3-wedge 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
}

/* Notes — lines draw */
.pl3-scene__line {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.3;
  stroke-linecap: round;
  stroke-dasharray: 120;
  stroke-dashoffset: 120;
}
.pl3-scene[data-active] .pl3-scene__line--a {
  animation: pl3-draw 0.7s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__line--b {
  animation: pl3-draw 0.7s 0.12s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__line--c {
  animation: pl3-draw 0.7s 0.24s ease forwards;
}

@keyframes pl3-bar-rise {
  to {
    transform: scaleY(1);
    opacity: 0.75;
  }
}
@keyframes pl3-bar-glow {
  0%,
  100% {
    opacity: 0.75;
  }
  50% {
    opacity: 1;
  }
}
@keyframes pl3-draw {
  to {
    stroke-dashoffset: 0;
  }
}
@keyframes pl3-dot-in {
  to {
    opacity: 1;
  }
}
@keyframes pl3-beat {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.35);
  }
}
@keyframes pl3-pulse-glow {
  0%,
  100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}
@keyframes pl3-slide-a {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }
  to {
    opacity: 0.85;
    transform: none;
  }
}
@keyframes pl3-slide-b {
  from {
    opacity: 0;
    transform: translateX(12px);
  }
  to {
    opacity: 0.85;
    transform: none;
  }
}
@keyframes pl3-fade {
  to {
    opacity: 0.6;
  }
}
@keyframes pl3-node-in {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 0.9;
    transform: scale(1);
  }
}
@keyframes pl3-ring {
  to {
    stroke-dashoffset: 44;
  }
}
@keyframes pl3-wedge {
  to {
    transform: scale(1);
  }
}

@media (max-width: 760px) {
  .pl3-journey__cards {
    height: auto;
    min-height: 48vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pl3-jcard {
    position: relative;
    top: auto;
    left: auto !important;
    right: auto !important;
    width: min(92%, 22rem);
    transform: none !important;
    margin: 0 auto;
    display: none;
  }

  .pl3-jcard[data-lit] {
    display: block;
    filter: none;
  }

  .pl3-jcard[data-passed] {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pl3-jcard,
  .pl3-journey__tick,
  .pl3-orb,
  .pl3-lightfall {
    transition: none !important;
  }

  /* Keep the orb on the journey path even when motion is reduced. */
  .pl3[data-journey] .pl3-orb {
    position: fixed !important;
    top: var(--orb-y) !important;
    left: var(--orb-x, 50vw) !important;
  }

  .pl3[data-journey] .pl3-lightfall {
    display: block;
  }

  .pl3-scene[data-active] .pl3-scene__bar,
  .pl3-scene[data-active] .pl3-scene__trend,
  .pl3-scene[data-active] .pl3-scene__pulse,
  .pl3-scene[data-active] .pl3-scene__ring,
  .pl3-scene[data-active] .pl3-scene__arc,
  .pl3-scene[data-active] .pl3-scene__line,
  .pl3-scene[data-active] .pl3-scene__block,
  .pl3-scene[data-active] .pl3-scene__node,
  .pl3-scene[data-active] .pl3-scene__wedge,
  .pl3-scene[data-active] .pl3-scene__dot,
  .pl3-scene[data-active] .pl3-scene__wealth-area,
  .pl3-scene[data-active] .pl3-scene__caption {
    animation: none !important;
    opacity: 0.85;
    stroke-dashoffset: 0;
    transform: none;
  }
}
