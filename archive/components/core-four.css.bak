/* The Core Four — ordinary scrolling flow, problem beside answer.
   Imported from CoreFour.tsx */

.pl3-core {
  position: relative;
  z-index: 5;
  max-width: 78rem;
  margin: 0 auto;
  padding: clamp(80px, 14vh, 160px) clamp(20px, 5vw, 48px) clamp(40px, 8vh, 90px);
}

.pl3-core__lead {
  max-width: 38rem;
  margin: 0 auto clamp(48px, 9vh, 110px);
  text-align: center;
}

.pl3-core__title {
  font-family: "Newsreader", ui-serif, Georgia, serif;
  font-weight: 300;
  font-size: clamp(1.75rem, 4.4vw, 3.1rem);
  line-height: 1.14;
  letter-spacing: -0.015em;
  color: var(--filament);
  text-wrap: balance;
}

.pl3-core__sub {
  margin-top: 18px;
  font-size: clamp(0.9rem, 1.3vw, 1.0625rem);
  line-height: 1.65;
  color: var(--ash);
  text-wrap: balance;
}

/* ── One face ──────────────────────────────────────────────── */

.pl3-face {
  padding: clamp(38px, 7vh, 76px) 0;
  border-top: 1px solid var(--line-soft);
}

.pl3-face:first-of-type {
  border-top: none;
}

.pl3-face__name {
  margin-bottom: clamp(20px, 3.5vh, 38px);
  text-align: center;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--ash-dim);
}

.pl3-face__pair {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: start;
  gap: clamp(16px, 3vw, 44px);
}

.pl3-face__side {
  min-width: 0;
  opacity: 0;
  transform: translateY(14px);
  transition:
    opacity 0.7s ease,
    transform 0.7s cubic-bezier(0.16, 0.8, 0.24, 1);
}

.pl3-face[data-seen] .pl3-face__side {
  opacity: 1;
  transform: none;
}

/* The light arrives a beat after the problem is felt. */
.pl3-face[data-seen] .pl3-face__side[data-side="solution"] {
  transition-delay: 0.26s;
}

.pl3-face__eyebrow {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--ash-dim);
}

.pl3-face__side[data-side="solution"] .pl3-face__eyebrow {
  color: var(--ember);
  opacity: 0.8;
}

/* The diagram carries the claim, so it gets real room — never a smudge. */
.pl3-face__motif {
  height: clamp(180px, 22vh, 250px);
  margin: clamp(14px, 2.4vh, 26px) 0 clamp(18px, 3vh, 30px);
}

.pl3-face__motif[data-side="problem"] {
  color: rgba(216, 196, 170, 0.46);
}

.pl3-face__motif[data-side="solution"] {
  color: var(--ember);
  filter: drop-shadow(0 0 16px rgba(255, 174, 71, 0.26));
}

.pl3-face__quote {
  font-family: "Newsreader", ui-serif, Georgia, serif;
  font-style: italic;
  font-weight: 300;
  font-size: clamp(1.25rem, 2.4vw, 1.9rem);
  line-height: 1.28;
  color: rgba(255, 244, 226, 0.84);
  text-wrap: balance;
}

.pl3-face__root {
  margin-top: 14px;
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--ash-dim);
}

.pl3-face__answer {
  font-size: clamp(1.1rem, 1.9vw, 1.5rem);
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--filament);
  text-wrap: balance;
}

.pl3-face__shift {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--ash-dim);
}

.pl3-face__arrow {
  color: var(--ember);
  opacity: 0.7;
}

.pl3-face__to {
  color: var(--ember);
}

/* ── The seam between the two states ───────────────────────── */

/* Stretch to the full height of the pair, otherwise `align-items: start`
   collapses the rules to their min-height and the seam reads as a stray dash. */
.pl3-face__seam {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding-top: clamp(26px, 4vh, 44px);
  color: var(--ash-dim);
}

.pl3-face__seam-rule {
  width: 1px;
  flex: 1;
  background: linear-gradient(to bottom, transparent, var(--line), transparent);
}

.pl3-face__seam-arrow {
  flex: none;
  font-size: 15px;
  line-height: 1;
  color: var(--ember);
  opacity: 0.6;
}

/* ── Stacked on small screens ──────────────────────────────── */

@media (max-width: 780px) {
  .pl3-face__pair {
    grid-template-columns: 1fr;
    gap: clamp(14px, 3vh, 26px);
  }

  .pl3-face__seam {
    flex-direction: row;
    padding-top: 0;
    width: 100%;
  }

  .pl3-face__seam-rule {
    width: auto;
    height: 1px;
    min-height: 0;
    background: linear-gradient(to right, transparent, var(--line), transparent);
  }

  .pl3-face__seam-arrow {
    transform: rotate(90deg);
  }

  .pl3-face__motif {
    height: clamp(150px, 26vh, 200px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .pl3-face__side {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
