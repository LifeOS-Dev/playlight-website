/* Facet mini-scenes - instrument diagrams that draw themselves in.
   Imported by FacetScene.tsx.

   These rules previously lived in journey.css. Without them every shape
   falls back to SVG's default black fill, which is invisible on this
   canvas - the reason Work / People / Habits rendered as black blobs. */

.pl3-scene {
  color: rgba(255, 174, 71, 0.55);
  height: 5.5rem;
}

.pl3-pcard[data-lit] .pl3-scene,
.pl3-facet[data-lit] .pl3-scene {
  color: var(--ember);
}

.pl3-scene__svg {
  width: 100%;
  height: 100%;
}

/* Wealth - bars rise, trend draws */
.pl3-scene__bar {
  fill: currentColor;
  opacity: 0.35;
  transform-box: fill-box;
  transform-origin: bottom center;
  transform: scaleY(0.12);
}

.pl3-scene[data-active] .pl3-scene__bar {
  animation: pl3-bar-rise 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
  animation-delay: calc(var(--bar-i, 0) * 80ms);
}

.pl3-scene[data-active] .pl3-scene__bar--peak {
  animation:
    pl3-bar-rise 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards,
    pl3-bar-glow 2.2s 1.1s ease-in-out infinite;
  animation-delay: calc(var(--bar-i, 0) * 80ms), 1.1s;
}

.pl3-scene__wealth-area {
  opacity: 0;
  pointer-events: none;
}

.pl3-scene[data-active] .pl3-scene__wealth-area {
  animation: pl3-fade 0.8s 0.55s ease forwards;
}

.pl3-scene__trend {
  stroke-dasharray: 180;
  stroke-dashoffset: 180;
  opacity: 0.85;
}

.pl3-scene[data-active] .pl3-scene__trend {
  animation: pl3-draw 1.2s 0.35s ease forwards;
}

.pl3-scene__caption {
  fill: currentColor;
  font-size: 10px;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__caption {
  animation: pl3-dot-in 0.35s 1.05s ease forwards;
}

.pl3-scene__axis {
  opacity: 0.25;
}

.pl3-scene__dot {
  fill: currentColor;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__dot {
  animation: pl3-dot-in 0.4s 1s ease forwards;
}

/* Health - pulse travels */
.pl3-scene__pulse {
  stroke-dasharray: 220;
  stroke-dashoffset: 220;
}

.pl3-scene[data-active] .pl3-scene__pulse {
  animation: pl3-draw 1.1s ease forwards, pl3-pulse-glow 2.4s 1s ease-in-out infinite;
}

.pl3-scene[data-active] .pl3-scene__dot--pulse {
  animation: pl3-dot-in 0.35s 0.7s ease forwards, pl3-beat 1.2s 1s ease-in-out infinite;
}

/* Work - blocks slide in */
.pl3-scene__block {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.2;
  opacity: 0;
}

.pl3-scene[data-active] .pl3-scene__block--a {
  animation: pl3-slide-a 0.7s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__block--b {
  animation: pl3-slide-b 0.7s 0.15s ease forwards;
}

.pl3-scene__link {
  opacity: 0;
}
.pl3-scene[data-active] .pl3-scene__link {
  animation: pl3-fade 0.4s 0.5s ease forwards;
}

/* People - nodes bloom */
.pl3-scene__node {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.2;
  opacity: 0;
  transform-origin: center;
}
.pl3-scene[data-active] .pl3-scene__node {
  animation: pl3-node-in 0.5s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__node--b {
  animation-delay: 0.1s;
}
.pl3-scene[data-active] .pl3-scene__node--c {
  animation-delay: 0.18s;
}
.pl3-scene[data-active] .pl3-scene__node--d {
  animation-delay: 0.26s;
}

/* Habits - ring fills */
.pl3-scene__ring {
  stroke-dashoffset: 176;
}
.pl3-scene[data-active] .pl3-scene__ring {
  animation: pl3-ring 1.4s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
}

/* Mind - arcs draw */
.pl3-scene__arc {
  stroke-dasharray: 80;
  stroke-dashoffset: 80;
}
.pl3-scene[data-active] .pl3-scene__arc--a {
  animation: pl3-draw 0.8s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__arc--b {
  animation: pl3-draw 0.9s 0.12s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__arc--c {
  animation: pl3-draw 1s 0.22s ease forwards;
}

/* Time - wedge grows */
.pl3-scene__wedge {
  opacity: 0.55;
  transform-origin: 80px 44px;
  transform: scale(0.2);
}
.pl3-scene[data-active] .pl3-scene__wedge {
  animation: pl3-wedge 0.9s cubic-bezier(0.16, 0.8, 0.24, 1) forwards;
}

/* Notes - lines draw */
.pl3-scene__line {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.3;
  stroke-linecap: round;
  stroke-dasharray: 120;
  stroke-dashoffset: 120;
}
.pl3-scene[data-active] .pl3-scene__line--a {
  animation: pl3-draw 0.7s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__line--b {
  animation: pl3-draw 0.7s 0.12s ease forwards;
}
.pl3-scene[data-active] .pl3-scene__line--c {
  animation: pl3-draw 0.7s 0.24s ease forwards;
}

@keyframes pl3-bar-rise {
  to {
    transform: scaleY(1);
    opacity: 0.75;
  }
}
@keyframes pl3-bar-glow {
  0%,
  100% {
    opacity: 0.75;
  }
  50% {
    opacity: 1;
  }
}
@keyframes pl3-draw {
  to {
    stroke-dashoffset: 0;
  }
}
@keyframes pl3-dot-in {
  to {
    opacity: 1;
  }
}
@keyframes pl3-beat {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.35);
  }
}
@keyframes pl3-pulse-glow {
  0%,
  100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}
@keyframes pl3-slide-a {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }
  to {
    opacity: 0.85;
    transform: none;
  }
}
@keyframes pl3-slide-b {
  from {
    opacity: 0;
    transform: translateX(12px);
  }
  to {
    opacity: 0.85;
    transform: none;
  }
}
@keyframes pl3-fade {
  to {
    opacity: 0.6;
  }
}
@keyframes pl3-node-in {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 0.9;
    transform: scale(1);
  }
}
@keyframes pl3-ring {
  to {
    stroke-dashoffset: 44;
  }
}
@keyframes pl3-wedge {
  to {
    transform: scale(1);
  }
}
