import { Apple, Play } from "lucide-react";

/** Matched store buttons — same chrome, same hierarchy. */
export function DownloadButtons({ size = "lg" }: { size?: "lg" | "sm" }) {
  return (
    <div className="pl3-cta" data-size={size}>
      <a href="#" className="pl3-cta__btn">
        <Apple className="pl3-cta__icon" />
        <span>
          <span className="pl3-cta__kicker">Download on the</span>
          <span className="pl3-cta__store">App Store</span>
        </span>
      </a>
      <a href="#" className="pl3-cta__btn">
        <Play className="pl3-cta__icon fill-current" />
        <span>
          <span className="pl3-cta__kicker">Get it on</span>
          <span className="pl3-cta__store">Google Play</span>
        </span>
      </a>
    </div>
  );
}
