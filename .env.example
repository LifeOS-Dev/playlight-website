# Signed-in web app. Leave empty to use https://app.playlight.app.
# Set /app only after same-domain routing is verified, or set a full https URL.
VITE_PLAYLIGHT_WEB_APP_URL=

# The two download buttons on the site. Both listings are hard-coded in
# src/stores.ts; set these only to point the buttons somewhere else.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
